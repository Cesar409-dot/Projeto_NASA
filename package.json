    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
